ce=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="445" width="665" height="350" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;Node.js 22 container&lt;br&gt;host :80 &amp;#8594; container :3000&lt;br&gt;&lt;i&gt;&quot;Frontend is Live&quot; page&lt;br&gt;+ status of the 4 backends&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#DCEEFB;strokeColor=#1D63ED;strokeWidth=2;fontColor=#0B2545;align=left;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="690" y="553" width="240" height="130" as="geometry"/></mxCell><mxCell id="fe_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="48" height="36" as="geometry"/></mxCell><mxCell id="us" value="&lt;b&gt;user-service&lt;/b&gt;  :3001&lt;br&gt;GET /, /health, /users" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#DCEEFB;strokeColor=#1D63ED;strokeWidth=2;fontColor=#0B2545;align=left;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="240" height="58" as="geometry"/></mxCell><mxCell id="us_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1"><mxGeometry x="1068" y="482" width="44" height="34" as="geometry"/></mxCell><mxCell id="ps" value="&lt;b&gt;products-service&lt;/b&gt;  :3002&lt;br&gt;GET /, /health, /products" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#DCEEFB;strokeColor=#1D63ED;strokeWidth=2;fontColor=#0B2545;align=left;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="1060" y="550" width="240" height="58" as="geometry"/></mxCell><mxCell id="ps_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1"><mxGeometry x="1068" y="562" width="44" height="34" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;orders-service&lt;/b&gt;  :3003&lt;br&gt;GET /, /health, /orders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#DCEEFB;strokeColor=#1D63ED;strokeWidth=2;fontColor=#0B2545;align=left;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="1060" y="630" width="240" height="58" as="geometry"/></mxCell><mxCell id="os_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1"><mxGeometry x="1068" y="642" width="44" height="34" as="geometry"/></mxCell><mxCell id="cs" value="&lt;b&gt;cart-service&lt;/b&gt;  :3004&lt;br&gt;GET /, /health, /cart" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#DCEEFB;strokeColor=#1D63ED;strokeWidth=2;fontColor=#0B2545;align=left;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="1060" y="710" width="240" height="58" as="geometry"/></mxCell><mxCell id="cs_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1"><mxGeometry x="1068" y="722" width="44" height="34" as="geometry"/></mxCell><mxCell id="igw" value="Internet Gateway&lt;br&gt;ecommerce-igw" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;fontColor=#232F3E;fillColor=#8C4FFF;shape=mxgraph.aws4.internet_gateway;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="382" y="590" width="56" height="56" as="geometry"/></mxCell><mxCell id="rt" value="Route table&lt;br&gt;0.0.0.0/0 &amp;#8594; IGW" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;fontColor=#232F3E;fillColor=#8C4FFF;shape=mxgraph.aws4.route_table;" vertex="1" parent="1"><mxGeometry x="455" y="265" width="50" height="50" as="geometry"/></mxCell><mxCell id="laptop" value="&lt;b&gt;Developer laptop&lt;/b&gt;&lt;br&gt;Windows 11&lt;br&gt;Docker Desktop, Terraform,&lt;br&gt;AWS CLI" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;fontColor=#232F3E;fillColor=#232F3E;shape=mxgraph.aws4.client;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;Docker Hub&lt;/b&gt;&lt;br&gt;sunilstark007/&amp;lt;service&amp;gt;:v1&lt;br&gt;5 public images" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#1D63ED;strokeWidth=2;fontColor=#0B2545;fontSize=13;align=left;spacingLeft=74;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="255" height="80" as="geometry"/></mxCell><mxCell id="hub_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1"><mxGeometry x="50" y="414" width="58" height="42" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;End user&lt;/b&gt; (browser)&lt;br&gt;http://&amp;lt;public_ip&amp;gt;" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;fontColor=#232F3E;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="64" height="64" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;2. terraform apply" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#7B42BC;strokeColor=#5C2D91;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="250" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;1. Build the 5 images on the laptop and push them to Docker Hub&lt;br&gt;2. terraform apply creates the VPC, subnet, IGW, route table, security group and EC2&lt;br&gt;3. EC2 user-data installs Docker, pulls the 5 images and runs the containers&lt;br&gt;4. The user opens http://&amp;lt;public_ip&amp;gt;: frontend (port 80) calls the 4 backends on ecommerce-net" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="300" height="145" as="geometry"/></mxCell><mxCell id="e101" value="1. build + push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1D63ED;strokeWidth=2;fontColor=#1D63ED;exitX=0.5;exitY=1;entryX=0.139;entryY=0;" edge="1" parent="1" source="laptop" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7B42BC;strokeWidth=2;exitX=0.9;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="laptop" target="tf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7B42BC;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.17;" edge="1" parent="1" source="tf" target="region"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e104" value="3. docker pull at boot (user-data)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1D63ED;strokeWidth=2;dashed=1;fontColor=#1D63ED;exitX=1;exitY=0.5;entryX=0;entryY=0.144;" edge="1" parent="1" source="hub" target="ec2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e105" value="4. HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="igw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="igw" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1D63ED;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe" target="us"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1D63ED;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe" target="ps"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1D63ED;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1D63ED;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe" target="cs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>